{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AtCoder: 型チェック",
      "type": "shell",
      "command": "C:\\Users\\glgln\\.bun\\bin\\bun.exe",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "AtCoder: サンプルテスト",
      "type": "shell",
      "command": "C:\\Users\\glgln\\.bun\\bin\\bun.exe",
      "args": [
        "scripts/test-samples.mjs",
        "${input:problem}"
      ],
      "problemMatcher": []
    },
    {
      "label": "AtCoder: Webデバッグ",
      "type": "shell",
      "command": "Get-Content -Raw '${workspaceFolder}\\${input:problem}\\samples\\${input:sample}.in' | & 'C:\\Users\\glgln\\.bun\\bin\\bun.exe' --inspect-brk '${workspaceFolder}\\${input:problem}\\Main.ts'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "problem",
      "type": "promptString",
      "description": "対象問題ディレクトリ",
      "default": "problems/practice-a"
    },
    {
      "id": "sample",
      "type": "promptString",
      "description": "サンプル番号",
      "default": "01"
    }
  ]
}
