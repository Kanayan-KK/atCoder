{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AtCoder: 問題とサンプルを選んでBunデバッグ",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/${input:problem}/Main.ts",
      "cwd": "${workspaceFolder}/${input:problem}",
      "runtime": "C:\\Users\\glgln\\.bun\\bin\\bun.exe",
      "stopOnEntry": true,
      "env": {
        "ATCODER_INPUT_FILE": "${workspaceFolder}/${input:problem}/samples/${input:sample}.in"
      }
    }
  ],
  "inputs": [
    {
      "id": "problem",
      "type": "promptString",
      "description": "対象問題ディレクトリ",
      "default": "problems/practice-a"
    },
    {
      "id": "sample",
      "type": "promptString",
      "description": "サンプル番号",
      "default": "01"
    }
  ]
}
